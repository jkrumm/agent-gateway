{
  "name": "agent-gateway",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agw": "bin/agw.ts"
  },
  "scripts": {
    "dev:server": "bun --watch server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit --allowImportingTsExtensions",
    "test": "bun test",
    "lint": "oxlint server tests",
    "format": "oxfmt server tests --write",
    "format:check": "oxfmt server tests --check",
    "start": "bun server/index.ts",
    "logs:tail": "tail -f ~/Library/Logs/agent-gateway.jsonl | bunx pino-pretty"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "elysia": "1.4.30",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "eslint-plugin-zod": "4.14.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.58.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3"
  }
}
